{
  "name": "aliyun-cyber-range-platform",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @aliyun-cyber-range/api --filter @aliyun-cyber-range/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --workspace-concurrency=1 -r test && node --test test/*.test.mjs",
    "verify:bootstrap": "pnpm test && pnpm build && pnpm iac:validate && docker compose config",
    "provider:download": "sh scripts/dev/download-alicloud-provider.sh",
    "provider:build": "sh scripts/provider/alicloud-fast-wait/build.sh",
    "iac:validate": "bash scripts/dev/validate-opentofu-example.sh",
    "iac:smoke": "bash scripts/dev/smoke-opentofu-enterprise-range.sh",
    "iac:smoke:plan": "bash scripts/dev/smoke-opentofu-enterprise-range.sh --plan-only",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "compose:up": "COMPOSE_BAKE=false docker compose up -d --build",
    "compose:smoke:mcp": "bash scripts/dev/smoke-mcp-compose.sh",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f web api postgres",
    "db:local:start": "bash scripts/dev/start-postgres.sh",
    "db:local:stop": "bash scripts/dev/stop-postgres.sh"
  }
}
