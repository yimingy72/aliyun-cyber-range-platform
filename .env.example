NODE_ENV=development
COMPOSE_PROJECT_NAME=aliyun_cyber_range
COMPOSE_PROFILES=

PNPM_REGISTRY=https://registry.npmmirror.com
PNPM_FETCH_RETRIES=10
PNPM_FETCH_RETRY_MIN_TIMEOUT=2000
PNPM_FETCH_RETRY_MAX_TIMEOUT=30000

WEB_PORT=3000
WEB_BIND_ADDRESS=127.0.0.1
API_PORT=3001
API_BIND_ADDRESS=127.0.0.1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8080/realms/cyber-range
NEXT_PUBLIC_OIDC_CLIENT_ID=platform-web
IMAGE_IMPORT_ALLOWED_ORIGINS=http://localhost:3000
PLATFORM_IMAGE_SECRET_KEY=replace-with-a-long-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=dev-admin-token

KEYCLOAK_PORT=8080
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_IMAGE=vdagxumcha4qdz-quay.xuanyuan.run/keycloak/keycloak:26.1.4
KEYCLOAK_REALM=cyber-range
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_FEATURES=token-exchange,admin-fine-grained-authz
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
OIDC_ISSUER=http://localhost:8080/realms/cyber-range
# Internal Compose URLs; browser-facing OIDC_ISSUER remains public.
OIDC_JWKS_URL=http://keycloak:8080/realms/cyber-range/protocol/openid-connect/certs
OIDC_TOKEN_ENDPOINT=http://keycloak:8080/realms/cyber-range/protocol/openid-connect/token
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=platform-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=platform-admin-dev-only
MCP_OIDC_CLIENT_ID=mcp-gateway
MCP_OIDC_CLIENT_SECRET=mcp-gateway-dev-only
MCP_OIDC_AUDIENCE=mcp-gateway
PLATFORM_API_AUDIENCE=platform-api
MCP_PORT=8787
MCP_BIND_ADDRESS=127.0.0.1
MCP_PUBLIC_URL=http://localhost:8787/mcp
CADDY_PUBLIC_HOST=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
MCP_SMOKE_USERNAME=mcp-smoke-sa
MCP_SMOKE_PASSWORD=change-me
MCP_SMOKE_OIDC_CLIENT_ID=mcp-smoke-sa
MCP_SMOKE_OIDC_CLIENT_SECRET=mcp-smoke-secret
POSTGRES_DB=cyber_range
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyber_range?schema=public

ALICLOUD_ACCESS_KEY=
ALICLOUD_SECRET_KEY=
ALICLOUD_REGION=cn-hangzhou
ALICLOUD_ZONE_ID=cn-hangzhou-h
ALICLOUD_IMAGE_ID=
ALICLOUD_INSTANCE_TYPE=auto
ALICLOUD_INSTANCE_TYPE_PREFERENCES=
ALICLOUD_RANGE_VPC_CIDR=10.70.0.0/16
ALICLOUD_RANGE_DMZ_CIDR=10.70.10.0/24
ALICLOUD_RANGE_OFFICE_CIDR=10.70.20.0/24
ALICLOUD_RANGE_SERVER_CIDR=10.70.30.0/24
ALICLOUD_RANGE_DMZ_PRIVATE_IP=10.70.10.10
ALICLOUD_RANGE_OFFICE_PRIVATE_IP=10.70.20.10
ALICLOUD_RANGE_SERVER_PRIVATE_IP=10.70.30.10
ALICLOUD_PROVIDER_ZIP_PATH=

RANGE_PROVISIONER_MODE=opentofu
# 仅 API 每六小时补刷最近七个完整账日；worker 不重复启动账单定时器。
BILLING_SYNC_INTERVAL_MS=21600000
# 每个 worker 的任务上限；新单实例批次的图并发由 OPENTOFU_SINGLE_INSTANCE_PARALLELISM 控制。
PROVISIONING_WORKER_RANGE_CONCURRENCY=2
PROVISIONING_WORKER_SINGLE_BATCH_CONCURRENCY=3
RANGE_CIDR_POOL=10.80.0.0/16,10.81.0.0/16
OPENTOFU_IMAGE=ghcr.io/opentofu/opentofu:1.13.1-minimal
OPENTOFU_BINARY=tofu
# OpenTofu 单次图执行资源并发，允许 1–32；总并发还需乘以 worker 数量和任务额度。
OPENTOFU_PARALLELISM=10
# 独立实例批次图并发；允许 1–32，与编排实例分开调节。
OPENTOFU_SINGLE_INSTANCE_PARALLELISM=20
ALICLOUD_PROVIDER_VERSION=1.282.0-range.1
# 默认校验脚本内固定摘要；自定义构建需填入其 provider.env 中的摘要。
ALICLOUD_PROVIDER_SHA256=
OPENTOFU_WORKSPACES_ROOT=.local/opentofu-workspaces
OPENTOFU_PROVIDER_MIRROR_HOST_PATH=./.local/provider-fast-wait/mirror
OPENTOFU_INSTANCE_TYPE=auto
OPENTOFU_INSTANCE_TYPE_PREFERENCES=
OPENTOFU_IMAGE_ID=
OPENTOFU_ALLOWED_INGRESS_CIDR=0.0.0.0/0
OPENTOFU_SYSTEM_DISK_CATEGORY=cloud_essd
OPENTOFU_SYSTEM_DISK_SIZE=40
OPENTOFU_INTERNET_MAX_BANDWIDTH_OUT=10
