 describe('range worker durable cost safety', () => {
+  it('recovers remaining EIPs after native ECS expiry without recreating the host or declaring early settlement', async () => {
+    jest.useFakeTimers();
+    try {
+      const f = await fixture('create');
+      await f.worker.process(f.job.id);
+      const created = await f.repository.getRangeInstanceById(f.instance.id);
+      expect(created?.resourceSummary?.diskInventoryHostIds).toEqual({ entry: 'i-owned' });
+      await f.repository.updateRangeInstance(f.instance.id, { expiresAt: new Date(Date.now() - 60_000) });
+      let eipReads = 0;
+      f.query.mockImplementation(async (input: any) => {
+        const common = { RequestId: 'native-expiry-fixture', TotalCount: 0, PageSize: 100, PageNumber: 1 };
+        if (input.action === 'DescribeInstances') return { ...common, Instances: { Instance: [] } };
+        if (input.action === 'DescribeDisks') return { ...common, Disks: { Disk: [] } };
+        if (input.action === 'DescribeEipAddresses') {
+          eipReads++;
+          expect(input.parameters.AllocationId).toBe('eip-owned');
+          expect((await f.repository.listBillingLedgerResources()).every(row => !row.releasedAt)).toBe(true);
+          expect((await f.repository.getRangeInstanceById(f.instance.id))?.status).toBe('destroying');
+          return { ...common, TotalCount: eipReads === 1 ? 1 : 0,
+            EipAddresses: { EipAddress: eipReads === 1 ? [{ AllocationId: 'eip-owned' }] : [] } };
+        }
+        throw new Error(`Unexpected recovery query ${input.action}`);
+      });
+      await f.worker.processExpiredInstances(new Date());
+      const expired = await f.repository.getRangeInstanceById(f.instance.id);
+      const job = await f.repository.getProvisionJobById(expired!.lastJobId!);
+      expect(job).toMatchObject({ jobType: 'destroy', triggeredBy: 'system:auto-expire' });
+      const running = f.worker.process(job!.id);
+      await jest.advanceTimersByTimeAsync(6_000);
+      await running;
+      expect(eipReads).toBe(2);
+      expect(f.provisioner.create).toHaveBeenCalledTimes(1);
+      expect(f.provisioner.destroy).toHaveBeenCalledTimes(1);
+      expect((await f.repository.getRangeInstanceById(f.instance.id))?.status).toBe('destroyed');
+      expect((await f.repository.listBillingLedgerResources()).every(row => row.releasedAt)).toBe(true);
+    } finally { jest.useRealTimers(); }
+  });
+
