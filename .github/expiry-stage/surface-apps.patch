diff --git a/apps/web/lib/cloud-execution-policy.ts b/apps/web/lib/cloud-execution-policy.ts
index a3f7a53..f8d4ced 100644
--- a/apps/web/lib/cloud-execution-policy.ts
+++ b/apps/web/lib/cloud-execution-policy.ts
@@ -27,0 +28,11 @@ export function verifiedTencentInstanceTypes(snapshot: import('./admin-types').I
+
+export function rangeExpiryError(expiresAt: string, provider: CloudWorkspaceView['provider'], now = Date.now()) {
+  const error = cloudExpiryError(expiresAt, provider, now);
+  if (error || provider !== 'alibaba_cloud') return error;
+  const latest = new Date(now); latest.setUTCFullYear(latest.getUTCFullYear() + 3);
+  const expiry = Date.parse(expiresAt);
+  if (expiry - now < 35 * 60_000 || Math.ceil(expiry / 60_000) * 60_000 > latest.getTime()) {
+    return '阿里云编排实例需预留至少 35 分钟且不超过三年，以设置云端自动释放。';
+  }
+  return null;
+}
