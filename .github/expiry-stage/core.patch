diff --git a/apps/api/src/provisioning/reconciliation-budget.ts b/apps/api/src/provisioning/reconciliation-budget.ts
new file mode 100644
index 0000000..1be042b
--- /dev/null
+++ b/apps/api/src/provisioning/reconciliation-budget.ts
@@ -0,0 +1,19 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+// Only inventory reconciliation inherits this budget; provisioning/cleanup has its own claim signal.
+const budget = new AsyncLocalStorage<AbortSignal>();
+
+export function runWithReconciliationBudget<T>(signal: AbortSignal, work: () => Promise<T>): Promise<T> {
+  return budget.run(signal, work);
+}
+
+export function assertReconciliationActive() {
+  budget.getStore()?.throwIfAborted();
+}
+
+export function reconciliationRequestSignal(timeoutMs: number): AbortSignal {
+  const signal = budget.getStore();
+  signal?.throwIfAborted();
+  const request = AbortSignal.timeout(timeoutMs);
+  return signal ? AbortSignal.any([signal, request]) : request;
+}
