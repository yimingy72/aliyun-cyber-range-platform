diff --git a/apps/api/src/provisioning/alibaba-range-expiry.ts b/apps/api/src/provisioning/alibaba-range-expiry.ts
new file mode 100644
index 0000000..9ce1f98
--- /dev/null
+++ b/apps/api/src/provisioning/alibaba-range-expiry.ts
@@ -0,0 +1,28 @@
+import { ConflictException } from '@nestjs/common';
+
+const MINUTE = 60_000;
+
+export function alibabaRangeAutoReleaseTime(expiresAt: string, now = Date.now(), minimumMinutes = 30): string {
+  const expiry = Date.parse(expiresAt);
+  const latest = new Date(now);
+  latest.setUTCFullYear(latest.getUTCFullYear() + 3);
+  // ECS truncates seconds. Round UP once, never release before the user's requested instant.
+  const release = Math.ceil(expiry / MINUTE) * MINUTE;
+  if (!Number.isFinite(expiry) || expiry - now < minimumMinutes * MINUTE || release > latest.getTime()) {
+    throw new ConflictException(`阿里云编排实例到期时间需在 ${minimumMinutes} 分钟之后且不超过三年，以设置云端自动释放；不会自动延长有效期。`);
+  }
+  return new Date(release).toISOString().replace('.000Z', 'Z');
+}
+
+export function assertAlibabaRangeExpiryPlan(plan: unknown, expiresAt: string | undefined, now = Date.now()) {
+  const changes = (plan as { resource_changes?: Array<{ type: string; change?: { actions?: string[]; after?: Record<string, unknown> } }> })?.resource_changes ?? [];
+  const hosts = changes.filter(change => change.type === 'alicloud_instance' && change.change?.actions?.includes('create'));
+  if (!hosts.length) return; // Deletes and policy-only updates must not re-arm or renew an existing VM.
+  const release = alibabaRangeAutoReleaseTime(expiresAt ?? '', now);
+  for (const host of hosts) {
+    if (host.change?.after?.auto_release_time !== release || host.change.after.instance_charge_type !== 'PostPaid'
+      || host.change.after.deletion_protection === true) {
+      throw new Error('Alibaba range creation plan lacks its exact frozen pay-as-you-go auto-release time');
+    }
+  }
+}
