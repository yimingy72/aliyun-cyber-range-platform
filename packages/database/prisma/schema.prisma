generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CloudProvider {
  alibaba_cloud
  tencent_cloud
}

enum IacType {
  opentofu
  terraform
}

enum UserRole {
  admin
  user
}

enum UserStatus {
  active
  disabled
}

enum ResourceVisibility {
  private
  platform
}

enum OperationSource {
  web
  mcp
  system
}

enum OperationAuditPhase {
  requested
  confirmation_required
  confirmed
  dispatched
  succeeded
  failed
}

enum IdempotentOperationStatus {
  accepted
  succeeded
  failed
}

enum RangeTemplateVersionStatus {
  draft
  published
  archived
}

enum RangeInstanceStatus {
  draft
  pending_create
  creating
  running
  create_failed
  pending_destroy
  destroying
  destroy_failed
  destroyed
}

enum RangeInstanceMode {
  range
  single
}

enum ProvisionJobType {
  create
  update
  destroy
  retry
  refresh_status
}

enum ProvisionJobStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum ProvisionJobStepStatus {
  pending
  running
  succeeded
  failed
}

enum BillingScope {
  user
  platform
}

enum BillingLedgerResourceType {
  ecs
  disk
  eip
  nat_gateway
  snat_entry
  dnat_entry
  image
  snapshot
  snapshot_region
  oss_bucket
  unknown
}

enum CloudAccountContextStatus {
  provisioning
  ready
  degraded
  disabled
}

enum ImageImportJobStatus {
  awaiting_upload
  importing
  available
  failed
  cancelled
}

enum CloudResourceDriftSeverity {
  warning
  critical
}

model CloudWorkspace {
  id                         String        @id @default(cuid())
  provider                   CloudProvider
  accountUid                 String?
  displayName                String
  isReadOnly                 Boolean       @default(false)
  activeCloudAccountContextId String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  @@unique([provider, accountUid])
  cloudAccountContextRows CloudAccountContext[]
  operationConfirmationRows OperationConfirmation[]
  idempotentOperationRows IdempotentOperation[]
  operationAuditEventRows OperationAuditEvent[]
  cloudImageSnapshotRows CloudImageSnapshot[]
  imageImportJobRows ImageImportJob[]
  cloudImageImportBucketRows CloudImageImportBucket[]
  packedImageArtifactRows PackedImageArtifact[]
  imageCatalogItemRows ImageCatalogItem[]
  platformImageAssetRows PlatformImageAsset[]
  platformImageTagRows PlatformImageTag[]
  platformImageAssetTagRows PlatformImageAssetTag[]
  rangeTemplateRows RangeTemplate[]
  rangeTemplateVersionRows RangeTemplateVersion[]
  singleInstanceBatchRows SingleInstanceBatch[]
  rangeInstanceRows RangeInstance[]
  singleInstanceNetworkProfileRows SingleInstanceNetworkProfile[]
  provisionJobRows ProvisionJob[]
  provisionJobStepLogRows ProvisionJobStepLog[]
  cloudResourceDriftRows CloudResourceDrift[]
  billingLedgerResourceRows BillingLedgerResource[]
  billingLineItemRows BillingLineItem[]
  billingAnomalyRows BillingAnomaly[]
  platformUserRows PlatformUser[]

}

model SystemCloudConfig {
  id              String   @id
  provider        String
  defaultRegion   String
  defaultZoneId   String
  accessKeyId     String
  accessKeySecret String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CloudAccountContext {
  cloudWorkspaceId String @default("legacy-unbound")
  id                String                    @id @default(cuid())
  displayName       String
  provider          CloudProvider             @default(alibaba_cloud)
  accountUid        String
  regionId          String
  zoneId            String
  accessKeyId       String
  accessKeySecret   String
  imageImportBucket String
  isActive          Boolean                   @default(false)
  status            CloudAccountContextStatus @default(provisioning)
  bucketStatus      String                    @default("pending")
  lastError         String?                   @db.Text
  lastVerifiedAt    DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  imageImportJobs  ImageImportJob[]

  @@unique([provider, accountUid, regionId])
  @@index([status, provider])
  @@index([isActive])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model PlatformUser {
  cloudWorkspaceId          String?
  loginUsername             String                @unique
  isPlatformManager         Boolean               @default(false)
  selectedCloudWorkspaceId  String?
  id                        String                @id
  username                  String
  passwordHash              String
  oidcIssuer                String?
  oidcSubject               String?
  role                      UserRole              @default(user)
  status                    UserStatus            @default(active)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  platformImageAssets       PlatformImageAsset[]
  createdImageTags          PlatformImageTag[]     @relation("PlatformImageTagCreator")
  rangeTemplates            RangeTemplate[]
  rangeInstances            RangeInstance[]
  singleInstanceBatches     SingleInstanceBatch[]
  imageImportJobs           ImageImportJob[]

  @@unique([oidcIssuer, oidcSubject])
  @@unique([cloudWorkspaceId, username])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace? @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model OperationConfirmation {
  cloudWorkspaceId String @default("legacy-unbound")
  id             String   @id @default(cuid())
  actorUserId    String
  oauthClientId  String
  toolName       String
  argumentsHash  String
  targetSnapshot Json?
  idempotencyKey String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([expiresAt])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model IdempotentOperation {
  cloudWorkspaceId String @default("legacy-unbound")
  id             String                    @id @default(cuid())
  actorUserId    String
  toolName       String
  idempotencyKey String
  argumentsHash  String
  operationId    String                    @unique
  status         IdempotentOperationStatus @default(accepted)
  result         Json?
  errorCode      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([cloudWorkspaceId, actorUserId, toolName, idempotencyKey])
  @@index([status, updatedAt])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model OperationAuditEvent {
  cloudWorkspaceId String @default("legacy-unbound")
  id             String              @id @default(cuid())
  operationId    String
  requestId      String
  actorUserId    String
  source         OperationSource
  oauthClientId  String?
  toolName       String
  phase          OperationAuditPhase
  targetType     String?
  targetId       String?
  sanitizedInput Json?
  jobId          String?
  errorCode      String?
  durationMs     Int?
  createdAt      DateTime            @default(now())

  @@index([operationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([source, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([jobId, phase, createdAt, id])
  @@index([createdAt, id])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model CloudImageSnapshot {
  minimumSystemDiskSize Int?
  cloudWorkspaceId String @default("legacy-unbound")
  id              String        @id @default(cuid())
  provider        CloudProvider @default(alibaba_cloud)
  accountUid      String?
  accountScopeKey String
  regionId        String
  scope           String
  imageId         String
  sourceImageName String
  osType          String?
  platform        String?
  architecture    String?
  status          String?
  isAvailable     Boolean       @default(true)
  lastSyncedAt    DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  catalogItems    ImageCatalogItem[]
  platformAssets  PlatformImageAsset[]

  @@unique([cloudWorkspaceId, provider, accountScopeKey, regionId, scope, imageId])
  @@index([provider, regionId, scope])
  @@index([accountUid])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model ImageImportJob {
  cloudProvider CloudProvider @default(alibaba_cloud)
  managedBucketId String?
  managedBucket CloudImageImportBucket? @relation(fields: [cloudWorkspaceId, managedBucketId], references: [cloudWorkspaceId, id], onDelete: Restrict)
  sourceObjectProof Json?
  sourceDiskIds Json @default("[]")
  osVersion String?
  cloudWorkspaceId String @default("legacy-unbound")
  id                    String               @id @default(cuid())
  cloudAccountContextId String
  cloudAccountUid       String?
  regionId              String?
  imageImportBucket     String?
  ownerUserId           String
  displayName           String
  defaultHostName       String?
  defaultPassword       String?
  description           String?
  osType                String
  platform              String?
  architecture          String
  bootMode              String
  imageFormat           String
  systemDiskSize        Int
  sourceFileName        String
  sourceContentType     String
  sourceSizeBytes       String
  objectKey             String
  uploadExpiresAt       DateTime
  uploadCompletedAt     DateTime?
  submissionRejected    Boolean              @default(false)
  lastPolledAt          DateTime?
  status                ImageImportJobStatus @default(awaiting_upload)
  imageId               String?
  taskId                String?
  sourceSnapshotId      String?
  platformImageAssetId  String?
  cloudImageDeletedAt   DateTime?
  backingSnapshotIds    String[]             @default([])
  deletedSnapshotIds    String[]             @default([])
  snapshotCleanupCompletedAt DateTime?
  temporaryObjectDeletedAt DateTime?
  leaseToken            String?
  leaseExpiresAt        DateTime?
  errorMessage          String?              @db.Text
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  cloudAccountContext   CloudAccountContext  @relation(fields: [cloudAccountContextId], references: [id], onDelete: Restrict)
  ownerUser             PlatformUser         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([cloudAccountContextId, status, updatedAt])
  @@index([ownerUserId, createdAt])
  @@index([status, lastPolledAt, createdAt])
  @@index([status, temporaryObjectDeletedAt, updatedAt])
  @@index([cloudWorkspaceId])
  @@unique([cloudWorkspaceId, imageId])
  @@unique([cloudWorkspaceId, objectKey])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model PackedImageArtifact {
  cloudProvider CloudProvider @default(alibaba_cloud)
  cloudWorkspaceId String @default("legacy-unbound")
  id                       String   @id @default(cuid())
  cloudAccountContextId    String
  cloudAccountUid          String
  regionId                 String
  ownerUserId              String
  sourceRangeInstanceId    String
  sourceHostKey            String
  sourceInstanceId         String
  sourceDiskIds            Json
  imageId                  String?
  sourceSnapshotId         String?
  platformImageAssetId     String?
  status                   String   @default("pending")
  backingSnapshotIds       Json     @default("[]")
  deletedSnapshotIds       Json     @default("[]")
  cloudImageDeletedAt      DateTime?
  completedAt              DateTime?
  lastPolledAt             DateTime?
  errorMessage             String?  @db.Text
  leaseToken               String?
  leaseExpiresAt           DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([cloudAccountUid, regionId, status])
  @@index([ownerUserId, createdAt])
  @@index([sourceSnapshotId])
  @@index([cloudWorkspaceId])
  @@unique([cloudWorkspaceId, imageId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model ImageCatalogItem {
  cloudWorkspaceId String @default("legacy-unbound")
  id               String        @id @default(cuid())
  displayName      String
  imageId          String
  provider         CloudProvider @default(alibaba_cloud)
  scope            String
  accountUid       String?
  accountScopeKey  String
  regionId         String
  enabled          Boolean       @default(true)
  sourceSnapshotId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sourceSnapshot   CloudImageSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)

  @@unique([cloudWorkspaceId, provider, accountScopeKey, regionId, scope, imageId])
  @@index([provider, regionId, scope])
  @@index([accountUid])
  @@index([sourceSnapshotId])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model PlatformImageAsset {
  cloudWorkspaceId String @default("legacy-unbound")
  id               String              @id @default(cuid())
  provider         CloudProvider       @default(alibaba_cloud)
  accountUid       String?
  accountScopeKey  String
  regionId         String
  sourceScope      String
  sourceSnapshotId String?
  imageId          String
  displayName      String
  defaultHostName  String?
  defaultPassword  String?
  description      String?
  ownerUserId      String?
  visibility       ResourceVisibility  @default(private)
  enabled          Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sourceSnapshot   CloudImageSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  ownerUser        PlatformUser?       @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  tags             PlatformImageAssetTag[]

  @@unique([cloudWorkspaceId, provider, accountScopeKey, regionId, imageId])
  @@index([provider, accountScopeKey, regionId])
  @@index([sourceSnapshotId])
  @@index([ownerUserId])
  @@index([visibility, enabled])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model PlatformImageTag {
  cloudWorkspaceId String @default("legacy-unbound")
  id              String                  @id @default(cuid())
  name            String
  normalizedName  String
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  createdByUser   PlatformUser?           @relation("PlatformImageTagCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  imageAssets     PlatformImageAssetTag[]

  @@index([createdByUserId])
  @@index([cloudWorkspaceId])
  @@unique([cloudWorkspaceId, normalizedName])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model PlatformImageAssetTag {
  cloudWorkspaceId String @default("legacy-unbound")
  platformImageAssetId String
  tagId                String
  createdAt            DateTime           @default(now())
  platformImageAsset   PlatformImageAsset @relation(fields: [platformImageAssetId], references: [id], onDelete: Cascade)
  tag                  PlatformImageTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([platformImageAssetId, tagId])
  @@index([tagId, platformImageAssetId])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model RangeTemplate {
  cloudWorkspaceId String @default("legacy-unbound")
  id                       String          @id @default(cuid())
  name                     String
  createdBy                String          @default("admin")
  ownerUserId              String?
  description              String?
  slug                     String
  version                  String
  cloudProvider            CloudProvider   @default(alibaba_cloud)
  iacType                  IacType         @default(opentofu)
  modulePathOrRef          String
  topologySpec             Json?
  topologyGraph            Json?
  scenarioTemplateSpec     Json?
  compiledProvisionSpec    Json?
  compiledSpec             Json?
  variableSchema           Json
  outputSchema             Json
  defaultNetworkPolicy     Json?
  visibility               ResourceVisibility @default(private)
  revision                 Int             @default(1)
  currentDraftVersionId    String?         @unique
  currentPublishedVersionId String?        @unique
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  rangeInstances           RangeInstance[]
  versions                 RangeTemplateVersion[]
  currentDraftVersion      RangeTemplateVersion? @relation("RangeTemplateCurrentDraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)
  currentPublishedVersion  RangeTemplateVersion? @relation("RangeTemplateCurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  ownerUser                PlatformUser?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@unique([cloudWorkspaceId, slug, version])
  @@index([ownerUserId])
  @@index([visibility, updatedAt])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model RangeTemplateVersion {
  cloudWorkspaceId String @default("legacy-unbound")
  id                   String                     @id @default(cuid())
  templateId           String
  version              String
  status               RangeTemplateVersionStatus @default(draft)
  modulePathOrRef      String
  topologySpec         Json?
  topologyGraph        Json?
  scenarioTemplateSpec Json?
  compiledProvisionSpec Json?
  compiledSpec         Json?
  variableSchema       Json
  outputSchema         Json
  defaultNetworkPolicy Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  template             RangeTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  currentDraftFor      RangeTemplate?             @relation("RangeTemplateCurrentDraftVersion")
  currentPublishedFor  RangeTemplate?             @relation("RangeTemplateCurrentPublishedVersion")

  @@index([templateId])
  @@index([status])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model SingleInstanceBatch {
  cloudWorkspaceId String @default("legacy-unbound")
  id                   String          @id @default(cuid())
  name                 String
  platformImageAssetId String
  imageId              String
  imageDisplayName     String
  cpu                  Int
  memory               Int
  systemDiskSize       Int
  quantity             Int
  remark               String?
  createdBy            String?
  ownerUserId          String?
  expiresAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  instances            RangeInstance[]
  ownerUser            PlatformUser?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([ownerUserId, createdAt])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model RangeInstance {
  cloudWorkspaceId String @default("legacy-unbound")
  id                           String              @id @default(cuid())
  name                         String
  createdBy                    String?             @default("admin")
  ownerUserId                  String?
  singleInstanceBatchId        String?
  templateId                   String?
  sourceTemplateVersionId      String?
  templateNameSnapshot         String?
  templateSlugSnapshot         String?
  templateVersionSnapshot      String?
  templateModulePathSnapshot   String?
  runtimeTopologyGraph         Json?
  runtimeScenarioTemplateSpec  Json?
  runtimeCompiledProvisionSpec Json?
  runtimeCredentials           Json?
  draftTopologyGraph           Json?
  draftTopologySpec            Json?
  draftScenarioTemplateSpec    Json?
  draftCompiledProvisionSpec   Json?
  draftRevision                Int                 @default(0)
  draftUpdatedBy               String?
  draftUpdatedAt               DateTime?
  status                       RangeInstanceStatus @default(draft)
  instanceMode                 RangeInstanceMode   @default(range)
  singleInstanceConfig         Json?
  allocatedCidr                String?
  cloudProvider                CloudProvider       @default(alibaba_cloud)
  accessEntry                  Json?
  resourceSummary              Json?
  errorSummary                 String?             @db.Text
  expiresAt                    DateTime?
  lastJobId                    String?             @unique
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  singleInstanceBatch          SingleInstanceBatch? @relation(fields: [singleInstanceBatchId], references: [id], onDelete: SetNull)
  template                     RangeTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  jobs                         ProvisionJob[]
  lastJob                      ProvisionJob?       @relation("RangeInstanceLastJob", fields: [lastJobId], references: [id], onDelete: SetNull)
  ownerUser                    PlatformUser?       @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([singleInstanceBatchId])
  @@index([templateId])
  @@index([sourceTemplateVersionId])
  @@index([status])
  @@index([instanceMode, status])
  @@index([status, expiresAt])
  @@index([ownerUserId, createdAt])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model SingleInstanceNetworkProfile {
  cloudWorkspaceId String @default("legacy-unbound")
  createdByUserId    String?
  cleanupRunId       String?
  cleanupRegisteredByUserId String?
  cleanupOwnerUserIds Json?
  status            String        @default("ready")
  cloudAccountUid   String        @default("legacy-unbound")
  cloudAccountContextId String?
  workspaceKey      String?
  managedByPlatform Boolean       @default(false)
  id                String        @id @default(cuid())
  provider          CloudProvider @default(alibaba_cloud)
  regionId          String
  zoneId            String
  vpcId             String
  vpcCidr           String
  vswitchIds        Json
  vswitchCidrs      Json
  securityGroupId   String
  securityGroupName String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([cloudWorkspaceId, provider, cloudAccountUid, regionId, zoneId])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model ProvisionJob {
  cloudWorkspaceId String @default("legacy-unbound")
  id              String               @id @default(cuid())
  rangeInstanceId String
  jobType         ProvisionJobType
  topologySnapshot Json?
  status          ProvisionJobStatus   @default(pending)
  triggeredBy     String
  startedAt       DateTime?
  finishedAt      DateTime?
  retryCount      Int                  @default(0)
  errorSummary    String?              @db.Text
  createdAt       DateTime             @default(now())
  availableAt     DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rangeInstance   RangeInstance        @relation(fields: [rangeInstanceId], references: [id], onDelete: Cascade)
  stepLogs        ProvisionJobStepLog[]
  lastForInstance RangeInstance?       @relation("RangeInstanceLastJob")

  @@index([rangeInstanceId])
  @@index([status])
  @@index([status, availableAt, createdAt, id])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model ProvisionJobStepLog {
  cloudWorkspaceId String @default("legacy-unbound")
  id            String                 @id @default(cuid())
  jobId         String
  stepName      String
  status        ProvisionJobStepStatus @default(pending)
  message       String?
  stdoutExcerpt String?                @db.Text
  stderrExcerpt String?                @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  job           ProvisionJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model CloudResourceDrift {
  cloudWorkspaceId String @default("legacy-unbound")
  id                String                     @id @default(cuid())
  cloudProvider     CloudProvider              @default(alibaba_cloud)
  regionId          String
  cloudResourceType String
  cloudResourceId   String
  rangeInstanceId   String?
  severity          CloudResourceDriftSeverity @default(critical)
  reason            String
  tagsSnapshot      Json                       @default("{}")
  firstSeenAt       DateTime                   @default(now())
  lastSeenAt        DateTime
  resolvedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([cloudWorkspaceId, cloudProvider, regionId, cloudResourceType, cloudResourceId])
  @@index([severity, resolvedAt, lastSeenAt])
  @@index([rangeInstanceId])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model BillingLedgerResource {
  cloudWorkspaceId String @default("legacy-unbound")
  id                  String                    @id @default(cuid())
  cloudProvider       CloudProvider             @default(alibaba_cloud)
  cloudAccountUid     String?
  regionId            String
  cloudResourceId     String
  cloudResourceType   BillingLedgerResourceType
  billingScope        BillingScope
  ownerUserId         String?
  rangeInstanceId     String?
  singleInstanceBatchId String?
  platformImageAssetId String?
  sourceProvisionJobId String?
  billingStartAt      DateTime
  releasedAt          DateTime?
  tagsSnapshot        Json                     @default("{}")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([cloudWorkspaceId, cloudProvider, regionId, cloudResourceId, cloudResourceType])
  @@index([ownerUserId, billingScope, billingStartAt])
  @@index([rangeInstanceId])
  @@index([singleInstanceBatchId])
  @@index([platformImageAssetId])
  @@index([cloudWorkspaceId])
  cloudWorkspace CloudWorkspace @relation(fields: [cloudWorkspaceId], references: [id], onDelete: Restrict)

}

model BillingLineItem {
  cloudWorkspaceId String @default("legacy-unbound")
  id                String                    @id @default(cuid())
  cloudProvider     CloudProvider @default(alibaba_cloud)
  cloudAccountUid   String?
  syncBatchId       String
  sourceFingerprint String
  billCycle         String
  billingDate       DateTime
  productCode       String
  productDetail     String?
  billItem          String
  cloudResourceId   String
  cloudResourceType BillingLedgerResourceType
  pretaxAmount      Decimal                   @db.Decimal(20, 9)
  currency          String
  billingScope      BillingScope
  ownerUserId       String?
  matchedLedgerId   String?
  rawPayload        Json                      @default("{}")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([billingDate, billingScope])
